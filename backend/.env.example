# =============================================================================
# Captain Truck API — environment variables
# Copy to .env and fill values. Never commit .env
# =============================================================================

# --- App ---
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# --- CORS (Phase 1) — comma-separated; NEVER use * in production ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate limit (Phase 1) — in-memory; Redis-backed later ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# --- Database Neon PostgreSQL (Phase 2) ---
# Pooled URL for the running app; direct URL for Prisma migrations.
DATABASE_URL=
DATABASE_URL_DIRECT=

# --- Auth JWT (required in production; Phase 3 uses them) ---
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# --- Redis / Upstash (Phase 10+) ---
REDIS_URL=

# --- Stripe Test Mode (Phase 13) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Cloudinary (Phase 11) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- FCM (Phase 15) ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- OSM / OSRM (Phase 7) ---
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
PHOTON_BASE_URL=https://photon.komoot.io

# --- Business (Phase 14) ---
COMMISSION_PERCENT=10
CHAT_TTL_DAYS=90
