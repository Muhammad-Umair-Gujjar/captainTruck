# =============================================================================
# Captain Truck API — environment variables
# Copy to .env and fill values. Never commit .env
# Phase 0 uses only NODE_ENV + PORT; remaining keys reserved for later phases.
# =============================================================================

# --- App (Phase 0+) ---
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# --- CORS (Phase 1) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database Neon PostgreSQL (Phase 2) ---
# Use pooled URL for the running app; direct URL for Prisma migrations.
DATABASE_URL=
DATABASE_URL_DIRECT=

# --- Auth JWT (Phase 3) ---
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# --- Redis / Upstash (Phase 10+) ---
REDIS_URL=

# --- Stripe Test Mode (Phase 13) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Cloudinary (Phase 11) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- FCM (Phase 15) ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- OSM / OSRM (Phase 7) ---
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
PHOTON_BASE_URL=https://photon.komoot.io

# --- Business (Phase 14) ---
COMMISSION_PERCENT=10
CHAT_TTL_DAYS=90
